# Sistema operacional
Thumbs.db
Desktop.ini
.DS_Store

# Arquivos temporários do Office
~$*.docx
~$*.xlsx
~$*.pptx

# Dados de clientes / sensíveis (não versionar)
clientes/
*.local.md
*-cliente-*.md
*-confidencial*

# Ambiente / credenciais
.env
*.key
*.pem

# Logs
*.log

# Python
__pycache__/
*.pyc

# Saídas geradas pelos geradores (reproduzíveis)
exemplos/

# Dados específicos de cliente (derivados do exemplo)
tools/data/cliente_*.yaml
tools/data/projeto_*.yaml

# Templates .docx reais da Rech (letterhead/logo) — manter local, não publicar
tools/templates/*.docx
