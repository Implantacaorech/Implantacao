# Sistema operacional
Thumbs.db
Desktop.ini
.DS_Store

# Arquivos temporários do Office
~$*.docx
~$*.xlsx
~$*.pptx

# Dados de clientes / sensíveis (não versionar)
clientes/
*.local.md
*-cliente-*.md
*-confidencial*

# Ambiente / credenciais
.env
*.key
*.pem

# Logs
*.log

# Python
__pycache__/
*.pyc

# Saídas geradas pelos geradores (reproduzíveis)
exemplos/

# Dados específicos de cliente (derivados do exemplo)
tools/data/cliente_*.yaml
tools/data/projeto_*.yaml
tools/data/lev_*.yaml
tools/data/termo_*.yaml
tools/data/crono_*.yaml
tools/data/_in_*.docx

# Chave de API da Anthropic (modo IA) — NUNCA versionar
tools/data/anthropic_key.txt

# Credenciais SMTP/IMAP do e-mail interno — NUNCA versionar (senha em texto local)
tools/data/smtp.json
tools/data/imap.json
tools/data/gmail_client.json
tools/data/disponibilidade.json
tools/data/gmail_token.json
tools/data/secret.key
tools/data/acesso.txt
tools/data/digest_para.txt

# Banco do Hub "Projetos por Cliente" — dados de cliente, NUNCA versionar
*.db

# Índice de embeddings da busca semântica do Vault (gerado, reproduzível via --indexar)
tools/data/vault_embeddings.json

# Templates .docx reais da Rech (letterhead/logo) — manter local, não publicar
tools/templates/*.docx

# Layouts fiéis dos modelos de documentos (base do Cadastro de Modelos) — manter local
tools/templates/layouts/
# Store gravável das versões enviadas dos modelos de documentos
tools/data/modelos_documento/

# Check List detalhado por módulo (roteiro interno) — manter local; o catálogo
# (catalogo_modulos.yaml) é versionado, o checklist detalhado não.
tools/data/checklist_modulos.yaml

# Painel web: uploads e dados de cliente gerados pelo painel
webapp/_uploads/
tools/data/upload_*.yaml

# Executável empacotado e artefatos de build (PyInstaller)
*.exe
build/
dist/
*.spec

# Arquivos do Power BI usados como REFERÊNCIA para portar os relatórios para o Painel
# (BI/BI_clientes.pbix tem ~134 MB — acima do limite de 100 MB por arquivo do GitHub).
# O que vale é o porte em backend/src/bi-implantacao + frontend/.../bi-implantacao.
BI/
*.pbix
*.pbit

# Prévias em PDF geradas pelos geradores de documento (artefato reproduzível, ~6 MB)
tools/data/_preview/

# Vault Obsidian e banco locais da máquina do desenvolvedor (dados/painel.db já cai no *.db)
# Padrão SEM barra inicial: casa QUALQUER pasta chamada `dados` em qualquer profundidade —
# é o que se quer para `./dados/` e `backend/dados/` (segredos: portal_db.json, graph.json,
# imap.json, anthropic_key.txt), mas pega junto código-fonte cujo módulo se chame `dados`.
dados/
# Exceção: o módulo da API de Dados (ADR-0003) é CÓDIGO. Sem esta linha ele some do commit
# em silêncio — o `git status` nem o lista como novo (descoberto em 2026-08-25, ao criá-lo).
!backend/src/dados/

# Certificado HTTPS do painel — chave PRIVADA, nunca versionar (o .pfx do
# Gerar_Certificado_Painel.ps1 abre o TLS do servidor para quem tiver o arquivo).
backend/certs/
*.pfx
*.p12

# Modelos de diarizacao (44 MB, baixados do k2-fsa/sherpa-onnx) — binario, nao versionar.
# Como obter: ver docs/gravacao-reuniao.md, secao "Separacao de locutores".
docservice/modelos/

# Configuracao local do Claude Code (permissoes pessoais desta maquina)
.claude/settings.local.json
