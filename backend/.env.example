# Nunca comitar valores reais — este arquivo só documenta as chaves esperadas.
# Prefixo MIGRACAO_ propositalmente distinto do prefixo PAINEL_ (Painel Flask em produção) —
# ver docs/migracao/03-documento-conversao.md sobre por que isso importa.

NODE_ENV=development
MIGRACAO_PORT=3000

# MariaDB (produção/homologação) — ÚNICO dialeto aceito (§4.8): prefixo mysql:// ou
# mariadb://; qualquer outro (ex.: postgresql://) FALHA O BOOT de propósito. Sem esta
# variável, cai para SQLite local (dev/testes).
# MIGRACAO_DB_URL=mysql://usuario:senha@localhost:3306/painel_novo

# Só usado quando MIGRACAO_DB_URL não está definida.
MIGRACAO_DB_SQLITE=dados/painel.sqlite

# Gere segredos fortes (ex.: `openssl rand -hex 32`) — nunca reutilize os valores de exemplo.
MIGRACAO_JWT_SECRET=troque-por-um-segredo-forte-de-producao
MIGRACAO_JWT_EXPIRES_IN=15m
MIGRACAO_JWT_REFRESH_SECRET=troque-por-outro-segredo-forte-de-producao
MIGRACAO_JWT_REFRESH_EXPIRES_IN=7d

MIGRACAO_CORS_ORIGINS=http://localhost:4200

# Serviço interno de geração de documentos/transcrição (docservice/), nunca exposto
# publicamente — padrão http://127.0.0.1:8001 se não definida.
# MIGRACAO_DOCSERVICE_URL=http://127.0.0.1:8001

# Consultor SIGER (Execução → Consultor SIGER): base DERIVADA do código-fonte, gerada pelo
# indexador externo (F:\CONSULTOR-SIGER\indexer\extrair.py). A fonte F:\SIGER é somente
# leitura e o Painel nem a acessa — só abre este SQLite em readonly. Ausente → a tela
# degrada com aviso (nada quebra).
# MIGRACAO_CONSULTOR_SIGER_DB=F:\CONSULTOR-SIGER\data\consultor.db

# Protocolos de Treinamento: pasta raiz sincronizada pelo OneDrive/SharePoint (contém
# Videos Pendentes/Processados/Com Erro). Padrão: a mesma pasta do Flask (PortalImplantacao
# \Treinamentos). Intervalo do robô de varredura, em minutos (piso real de 2 min).
# MIGRACAO_PROTOCOLOS_DIR=C:\SEG-EVE\OneDrive - rech.com.br\PortalImplantacao\Treinamentos
MIGRACAO_PROTOCOLOS_POLL_MIN=10

# Chave/modelo da API Claude (Anthropic), usada pela análise de IA dos Protocolos de
# Treinamento. Alternativa: configurar pela tela Config → IA (grava em
# dados/anthropic_key.txt, nunca no banco) — a variável de ambiente, se definida, tem
# prioridade sobre o arquivo.
# MIGRACAO_ANTHROPIC_API_KEY=sk-ant-...
MIGRACAO_ANTHROPIC_MODELO=claude-opus-4-8

# E-mail (Microsoft 365 / API do Graph) — é o CAMINHO OFICIAL de envio. Valores do registro
# de aplicativo no Entra ID, fornecidos pelo TI (nomes definidos por eles). Alternativa:
# configurar pela tela Config → E-mail (Microsoft 365), que grava em dados/graph.json —
# nunca no banco. As variáveis de ambiente têm prioridade sobre o arquivo.
# EMAIL_GRAPH_TENANT_ID=00000000-0000-0000-0000-000000000000
# EMAIL_GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000
# EMAIL_GRAPH_CLIENT_SECRET=segredo-do-aplicativo
# EMAIL_REMETENTE=implantacao@rech.com.br

# E-mail (SMTP) — envio ALTERNATIVO, para relay interno. O Microsoft 365 não aceita mais
# usuário e senha aqui; num relay autorizado por IP, deixe USER/PASS em branco.
# MIGRACAO_SMTP_HOST=smtp.office365.com
# MIGRACAO_SMTP_PORT=587
# MIGRACAO_SMTP_USER=usuario@empresa.com
# MIGRACAO_SMTP_PASS=senha-de-app
# MIGRACAO_SMTP_FROM=implantacao@empresa.com
# MIGRACAO_SMTP_TLS=true

# Caixa de entrada (IMAP) — robô que cria projetos a partir do e-mail de fechamento do
# Comercial. Alternativa: tela Config → Caixa de entrada (dados/imap.json).
# MIGRACAO_IMAP_HOST=outlook.office365.com
# MIGRACAO_IMAP_PORT=993
# MIGRACAO_IMAP_USER=usuario@empresa.com
# MIGRACAO_IMAP_PASS=senha-de-app
# MIGRACAO_IMAP_FOLDER=INBOX
MIGRACAO_IMAP_POLL_MIN=10

# Destinatários do digest diário (e fallback de notificação da Coordenação, se não houver
# usuário ativo com perfil ADM/Coordenador) — lista separada por vírgula/ponto e vírgula.
# Alternativa: arquivo dados/digest_para.txt (um e-mail por linha).
# MIGRACAO_DIGEST_PARA=coordenacao@empresa.com,adm@empresa.com

# Pasta de logs de operação e zips de backup (lida pela tela Saúde; escrita pelos scripts
# Iniciar/Guardião/Backup/Verificação, que também a respeitam). Padrão: C:\PainelBackups.
# MIGRACAO_BACKUP_DIR=C:\PainelBackups

# HTTPS (certificado da CA interna ou autoassinado — ver Certificado_CA_Interna_Painel.bat).
# MIGRACAO_HTTPS_PFX=certs/painel-ca.pfx
# MIGRACAO_HTTPS_PFX_SENHA=senha-do-pfx
# MIGRACAO_HTTPS_PORT=5443
# Estado final do servidor dedicado (docs/migracao-servidor.md): HTTP nem abre e o HSTS
# liga. Só ative quando não houver mais favoritos http:// em uso.
# MIGRACAO_HTTPS_SOMENTE=1
