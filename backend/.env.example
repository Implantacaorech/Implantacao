# Nunca comitar valores reais — este arquivo só documenta as chaves esperadas.
# Prefixo MIGRACAO_ propositalmente distinto do prefixo PAINEL_ (Painel Flask em produção) —
# ver docs/migracao/03-documento-conversao.md sobre por que isso importa.

NODE_ENV=development
MIGRACAO_PORT=3000

# Postgres (produção/homologação). Sem esta variável, cai para SQLite local (dev/testes).
# MIGRACAO_DB_URL=postgresql://usuario:senha@host:5432/painel_v2

# Só usado quando MIGRACAO_DB_URL não está definida.
MIGRACAO_DB_SQLITE=dados/painel.sqlite

# Gere segredos fortes (ex.: `openssl rand -hex 32`) — nunca reutilize os valores de exemplo.
MIGRACAO_JWT_SECRET=troque-por-um-segredo-forte-de-producao
MIGRACAO_JWT_EXPIRES_IN=15m
MIGRACAO_JWT_REFRESH_SECRET=troque-por-outro-segredo-forte-de-producao
MIGRACAO_JWT_REFRESH_EXPIRES_IN=7d

MIGRACAO_CORS_ORIGINS=http://localhost:4200
