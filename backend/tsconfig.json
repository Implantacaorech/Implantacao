{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    // Único sub-flag do `strict` desligado, de propósito: DTOs (class-validator) e entities
    // (TypeORM) declaram propriedades que são preenchidas pelo framework via decorator, não
    // no construtor — com ele ligado, o build acusa TS2564 em 323 propriedades legítimas.
    // Ligá-lo exigiria `!` em cada uma, sem ganho real de segurança. Os demais flags do
    // `strict` (strictNullChecks, noImplicitAny, strictFunctionTypes…) seguem ativos, que é
    // o que a §4.8.2 dos Padrões da Rech busca.
    "strictPropertyInitialization": false,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "noFallthroughCasesInSwitch": true
  }
}
